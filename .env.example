# =====================================================================
# Archivo de Ejemplo de Configuración (.env.example)
# Copie este archivo como '.env' en la raíz del proyecto si no existe:
#   cp .env.example .env
# =====================================================================

# --- Broker MQTT (EMQX) ---
# Nombre del servicio en Docker o IP del broker
MQTT_BROKER_HOST=emqx
MQTT_BROKER_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_QOS=1
MQTT_KEEPALIVE=60
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASS=public

# --- Base de Datos Relacional (MySQL 8.0) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=emqx_db
MYSQL_USER=emqx_user
MYSQL_PASSWORD=emqx_pass
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_POOL_SIZE=10

# --- Simulación de Secadores Virtuales ---
# Modifique N_SECADORES para escalar la flota (ej. 5, 20, 50)
# Para aplicar: docker compose up -d
N_SECADORES=5
INTERVALO_PUB_SEC=2.0
TEMP_IDEAL_DEFAULT=38.0
INYECTAR_FALLAS=false
