# Configuración del Broker MQTT (EMQX)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_QOS=1
MQTT_KEEPALIVE=60

# Configuración del Simulador
N_SECADORES=5
INTERVALO_PUB_SEC=2.0
TEMP_IDEAL_DEFAULT=38.0
INYECTAR_FALLAS=false

# Configuración de Base de Datos MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=emqx_db
MYSQL_USER=emqx_user
MYSQL_PASSWORD=emqx_pass
MYSQL_POOL_SIZE=10
